<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Register | CampusConnect</title><link rel="stylesheet" href="css/style.css"></head><body>
<header class="topbar"><a class="brand" href="index.jsp">Campus<span>Connect</span></a><nav><a href="index.jsp">Home</a><a href="events">Events</a></nav></header>
<main class="form-wrap"><p class="eyebrow">YOU’RE INVITED</p><h1 class="page-title">Save your <span>spot.</span></h1><p class="lead">Fill in your details to register for <strong><%= request.getParameter("eventTitle") == null ? "your selected event" : request.getParameter("eventTitle") %></strong>.</p>
<form class="register-form" action="register" method="post"><label>Full name<input name="studentName" required maxlength="120" placeholder="e.g. Aanya Sharma"></label><label>Student email<input name="studentEmail" type="email" required maxlength="160" placeholder="you@college.edu"></label><label>Student ID<input name="studentId" required maxlength="40" placeholder="Your college ID"></label><input type="hidden" name="eventId" value="<%= request.getParameter("eventId") == null ? "" : request.getParameter("eventId") %>"><button class="button" type="submit">Complete registration →</button></form></main><footer>Made for campus life <span>© College Event Registration</span></footer></body></html>
